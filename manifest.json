{
  "manifest_version": 3,
  "name": "NPTEL Whisperer",
  "version": "1.5.0",
  "description": "Modular auto-injector for NPTEL course programming assignments and MCQ assessments.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["solutions.json"],
      "matches": ["*://onlinecourses.nptel.ac.in/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "NPTEL Whisperer"
  },
  "content_scripts": [
    {
      "matches": [
        "*://onlinecourses.nptel.ac.in/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}